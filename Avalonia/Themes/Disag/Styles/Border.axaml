<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusZero}" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style Selector="Border.card-error">
        <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusZero}" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style Selector="Border.card-dark">
        <Setter Property="Background" Value="{DynamicResource SurfaceDarkBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style Selector="Border.card-success">
        <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusZero}" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style Selector="Border.card-accent">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
        <Setter Property="Padding" Value="24" />
    </Style>

</Styles>
