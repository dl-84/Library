<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
        <Setter Property="Foreground" Value="{DynamicResource InputPlaceholderBrush}" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="TextBox:focus-within /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}" />
    </Style>

    <Style Selector="TextBox:disabled">
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="Background" Value="{DynamicResource AppBackgroundAltBrush}" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <Style Selector="TextBox.error">
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="TextBox.error:focus-within /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <Style Selector="TextBox.success">
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
    </Style>

</Styles>
