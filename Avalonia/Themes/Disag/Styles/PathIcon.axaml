<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="PathIcon.icon-action">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <Style Selector="PathIcon.icon-action:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
    </Style>

    <Style Selector="PathIcon.icon-action:disabled">
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    </Style>

    <Style Selector="PathIcon.icon-action.icon-danger">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <Style Selector="PathIcon.icon-action.icon-danger:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <Style Selector="PathIcon.icon-action.icon-danger:disabled">
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    </Style>
</Styles>
