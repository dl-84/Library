<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="PathIcon.icon-action">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource InputFocusBorderBrush}" />
    </Style>

    <Style Selector="PathIcon.icon-action:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource InputHoverBorderBrush}" />
    </Style>

    <Style Selector="PathIcon.icon-action:disabled">
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <Style Selector="PathIcon.icon-action.icon-danger">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <Style Selector="PathIcon.icon-action.icon-danger:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <Style Selector="PathIcon.icon-action.icon-danger:disabled">
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <Style Selector="PathIcon.status-error">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <Style Selector="PathIcon.status-success">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>

    <Style Selector="TextBox PathIcon.clear-icon">
        <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="TextBox:pointerover PathIcon.clear-icon">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="PathIcon.db-status-up-to-date">
        <Setter Property="Data" Value="{DynamicResource CheckCircleIcon}" />
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>

    <Style Selector="PathIcon.db-status-update-available">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Data" Value="{DynamicResource RefreshIcon}" />
        <Setter Property="Foreground" Value="{DynamicResource TertiaryBrush}" />
    </Style>

    <Style Selector="PathIcon.db-status-not-initialized">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Data" Value="{DynamicResource InitializeDbIcon}" />
        <Setter Property="Foreground" Value="{DynamicResource TertiaryBrush}" />
    </Style>
</Styles>
