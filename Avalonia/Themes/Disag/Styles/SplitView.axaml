<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="SplitView">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    </Style>

    <Style Selector="SplitView /template/ Panel#PART_PaneRoot">
        <Setter Property="Background" Value="{DynamicResource NavigationBackgroundBrush}" />
    </Style>

</Styles>
