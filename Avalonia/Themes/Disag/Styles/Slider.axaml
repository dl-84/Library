<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Slider">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Slider /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style Selector="Slider /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="{DynamicResource BorderMediumBrush}" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style Selector="Slider /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextWhiteBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Slider:disabled">
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

</Styles>
