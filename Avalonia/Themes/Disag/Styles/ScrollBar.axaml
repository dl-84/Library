<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <TransformOperations x:Key="VerticalSmallScrollThumbScaleTransform">scaleX(1)</TransformOperations>
            <TransformOperations x:Key="HorizontalSmallScrollThumbScaleTransform">scaleY(1)</TransformOperations>
            <x:Double x:Key="ScrollBarSize">8</x:Double>
            <SolidColorBrush x:Key="ScrollBarButtonArrowForeground"
                             Color="{DynamicResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPointerOver"
                             Color="{DynamicResource TextSecondaryColor}" />
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource BorderMediumBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <Style Selector="ScrollBar:pointerover /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton,                      ScrollBar /template/ RepeatButton#PART_LineDownButton">
        <Setter Property="Opacity" Value="1" />
    </Style>

</Styles>
