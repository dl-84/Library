<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PrimaryDarkColor">#FF012a38</Color>
    <Color x:Key="PrimaryDarkerColor">#FF102330</Color>
    <Color x:Key="NearBlackColor">#FF161922</Color>
    <Color x:Key="SecondaryColor">#FF8bba30</Color>
    <Color x:Key="SecondaryDarkColor">#FF6f9526</Color>
    <Color x:Key="TertiaryColor">#FF33a6cc</Color>
    <Color x:Key="TertiaryDarkColor">#FF2985a3</Color>
    <Color x:Key="NavigationActiveColor">#FF1a404c</Color>
    <Color x:Key="IconActionColor">#FF8bba30</Color>
    <Color x:Key="IconActionHoverColor">#FF6f9526</Color>

    <Color x:Key="TextPrimaryColor">#FF333333</Color>
    <Color x:Key="TextSecondaryColor">#FF626262</Color>
    <Color x:Key="TextMutedColor">#FFbbbbbb</Color>
    <Color x:Key="TextDisabledColor">#FFA6A6A6</Color>
    <Color x:Key="TextOnDarkColor">#FFf9f9f9</Color>
    <Color x:Key="TextWhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TableHeaderTextColor">#FF5e6e78</Color>

    <Color x:Key="BackgroundWhiteColor">#FFFFFFFF</Color>
    <Color x:Key="BackgroundLightColor">#FFe9ecf1</Color>
    <Color x:Key="BackgroundSubtleColor">#FFf8f8f8</Color>
    <Color x:Key="BackgroundTintedColor">#FFe9f5fc</Color>
    <Color x:Key="BackgroundMutedColor">#FFeef2f5</Color>
    <Color x:Key="SuccessColor">#FF8bba30</Color>
    <Color x:Key="WarningColor">#FF8a6a08</Color>
    <Color x:Key="ErrorColor">#FFc23b3b</Color>
    <Color x:Key="ErrorHoverColor">#FF7c1c12</Color>

    <Color x:Key="BorderLightColor">#FFEBEBEB</Color>
    <Color x:Key="BorderMediumColor">#FFcccccc</Color>
    <Color x:Key="BorderDarkColor">#FF012a38</Color>
    <Color x:Key="BorderTableColor">#FFd5dae2</Color>
    <Color x:Key="InputHoverBorderColor">#FF1b4f5f</Color>

    <Color x:Key="OverlayColor">#99000000</Color>
</ResourceDictionary>
