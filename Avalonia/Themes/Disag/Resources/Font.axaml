<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="FontBody">Arial,Segoe UI,Helvetica Neue,sans-serif</FontFamily>
    <FontFamily x:Key="FontHeading">Montserrat,Segoe UI,Arial,sans-serif</FontFamily>
    <FontFamily x:Key="FontMono">Consolas,Courier New,monospace</FontFamily>

    <x:Double x:Key="FontSizeSmall">13</x:Double>
    <x:Double x:Key="FontSizeBody">16</x:Double>
    <x:Double x:Key="FontSizeMedium">18</x:Double>
    <x:Double x:Key="FontSizeMediumLarge">22</x:Double>
    <x:Double x:Key="FontSizeLarge">36</x:Double>
    <x:Double x:Key="FontSizeXLarge">42</x:Double>

</ResourceDictionary>
