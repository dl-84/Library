<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="FontBody">Inter,Arial,Segoe UI,Helvetica Neue,sans-serif</FontFamily>
    <FontFamily x:Key="FontHeading">Inter,Arial,Segoe UI,Helvetica Neue,sans-serif</FontFamily>
    <FontFamily x:Key="FontMono">Consolas,Courier New,monospace</FontFamily>

    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <x:Double x:Key="FontSizeSmall">14</x:Double>
    <x:Double x:Key="FontSizeBody">16</x:Double>
    <x:Double x:Key="FontSizeMedium">18</x:Double>
    <x:Double x:Key="FontSizeMediumLarge">22</x:Double>
    <x:Double x:Key="FontSizeLarge">28</x:Double>
    <x:Double x:Key="FontSizeXLarge">34</x:Double>

</ResourceDictionary>
