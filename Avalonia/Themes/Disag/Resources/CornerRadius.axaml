<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <CornerRadius x:Key="CornerRadiusZero">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">5</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">10</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">20</CornerRadius>

</ResourceDictionary>
