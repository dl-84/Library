<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PrimaryDarkColor">#FF012e3b</Color>
    <Color x:Key="PrimaryDarkerColor">#FF102330</Color>
    <Color x:Key="NearBlackColor">#FF161922</Color>
    <Color x:Key="AccentCyanColor">#FF019dc6</Color>
    <Color x:Key="AccentCyanDarkColor">#FF007897</Color>
    <Color x:Key="AccentGreenColor">#FF8bba30</Color>
    <Color x:Key="AccentGreenDarkColor">#FF8bb820</Color>

    <Color x:Key="TextPrimaryColor">#FF333333</Color>
    <Color x:Key="TextSecondaryColor">#FF626262</Color>
    <Color x:Key="TextMutedColor">#FFbbbbbb</Color>
    <Color x:Key="TextDisabledColor">#FFA6A6A6</Color>
    <Color x:Key="TextOnDarkColor">#FFf9f9f9</Color>
    <Color x:Key="TextWhiteColor">#FFFFFFFF</Color>

    <Color x:Key="BackgroundWhiteColor">#FFFFFFFF</Color>
    <Color x:Key="BackgroundLightColor">#FFf5f5f5</Color>
    <Color x:Key="BackgroundSubtleColor">#FFf8f8f8</Color>
    <Color x:Key="BackgroundTintedColor">#FFe9f5fc</Color>
    <Color x:Key="BackgroundMutedColor">#FFeef2f5</Color>
    <Color x:Key="BackgroundDarkColor">#FF012e3b</Color>

    <Color x:Key="SuccessColor">#FF3baf29</Color>
    <Color x:Key="WarningColor">#FFe5b80d</Color>
    <Color x:Key="ErrorColor">#FF962317</Color>

    <Color x:Key="BorderLightColor">#FFEBEBEB</Color>
    <Color x:Key="BorderMediumColor">#FFcccccc</Color>
    <Color x:Key="BorderDarkColor">#FF012e3b</Color>

    <Color x:Key="OverlayColor">#99000000</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush"
                     Color="{StaticResource BackgroundWhiteColor}" />
    <SolidColorBrush x:Key="AppBackgroundAltBrush"
                     Color="{StaticResource BackgroundLightColor}" />
    <SolidColorBrush x:Key="AppBackgroundTintBrush"
                     Color="{StaticResource BackgroundTintedColor}" />

    <SolidColorBrush x:Key="SurfaceBrush"
                     Color="{StaticResource BackgroundWhiteColor}" />
    <SolidColorBrush x:Key="SurfaceSubtleBrush"
                     Color="{StaticResource BackgroundSubtleColor}" />
    <SolidColorBrush x:Key="SurfaceDarkBrush"
                     Color="{StaticResource PrimaryDarkColor}" />

    <SolidColorBrush x:Key="PrimaryBrush"
                     Color="{StaticResource PrimaryDarkColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush"
                     Color="{StaticResource PrimaryDarkerColor}" />
    <SolidColorBrush x:Key="PrimaryForegroundBrush"
                     Color="{StaticResource TextWhiteColor}" />

    <SolidColorBrush x:Key="AccentBrush"
                     Color="{StaticResource AccentCyanColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush"
                     Color="{StaticResource AccentCyanDarkColor}" />
    <SolidColorBrush x:Key="AccentForegroundBrush"
                     Color="{StaticResource TextWhiteColor}" />

    <SolidColorBrush x:Key="AccentGreenBrush"
                     Color="{StaticResource AccentGreenColor}" />
    <SolidColorBrush x:Key="AccentGreenHoverBrush"
                     Color="{StaticResource AccentGreenDarkColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush"
                     Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush"
                     Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush"
                     Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush"
                     Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="TextOnDarkBrush"
                     Color="{StaticResource TextOnDarkColor}" />
    <SolidColorBrush x:Key="TextWhiteBrush"
                     Color="{StaticResource TextWhiteColor}" />
    <SolidColorBrush x:Key="TextNearBlackBrush"
                     Color="{StaticResource NearBlackColor}" />

    <SolidColorBrush x:Key="LinkBrush"
                     Color="{StaticResource AccentGreenColor}" />
    <SolidColorBrush x:Key="LinkHoverBrush"
                     Color="{StaticResource AccentCyanColor}" />

    <SolidColorBrush x:Key="InputBackgroundBrush"
                     Color="{StaticResource BackgroundWhiteColor}" />
    <SolidColorBrush x:Key="InputBorderBrush"
                     Color="{StaticResource BorderMediumColor}" />
    <SolidColorBrush x:Key="InputFocusBorderBrush"
                     Color="{StaticResource AccentCyanColor}" />
    <SolidColorBrush x:Key="InputForegroundBrush"
                     Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="InputPlaceholderBrush"
                     Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="BorderLightBrush"
                     Color="{StaticResource BorderLightColor}" />
    <SolidColorBrush x:Key="BorderMediumBrush"
                     Color="{StaticResource BorderMediumColor}" />
    <SolidColorBrush x:Key="BorderBrandBrush"
                     Color="{StaticResource PrimaryDarkColor}" />

    <SolidColorBrush x:Key="NavigationBackgroundBrush"
                     Color="{StaticResource BackgroundWhiteColor}" />
    <SolidColorBrush x:Key="NavigationForegroundBrush"
                     Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="NavigationActiveBrush"
                     Color="{StaticResource PrimaryDarkColor}" />
    <SolidColorBrush x:Key="NavigationHoverBrush"
                     Color="{StaticResource BackgroundTintedColor}" />
    <SolidColorBrush x:Key="NavigationActiveTextBrush"
                     Color="{StaticResource TextWhiteColor}" />

    <SolidColorBrush x:Key="FooterBackgroundBrush"
                     Color="{StaticResource PrimaryDarkColor}" />
    <SolidColorBrush x:Key="FooterForegroundBrush"
                     Color="{StaticResource TextOnDarkColor}" />
    <SolidColorBrush x:Key="FooterLinkBrush"
                     Color="{StaticResource TextOnDarkColor}" />
    <SolidColorBrush x:Key="FooterLinkHoverBrush"
                     Color="{StaticResource AccentCyanDarkColor}" />

    <SolidColorBrush x:Key="SuccessBrush"
                     Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush"
                     Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush"
                     Color="{StaticResource ErrorColor}" />

    <SolidColorBrush x:Key="OverlayBrush"
                     Color="{StaticResource OverlayColor}" />

    <CornerRadius x:Key="CornerRadiusZero">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">5</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">10</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">20</CornerRadius>

    <FontFamily x:Key="FontBody">Arial,Segoe UI,Helvetica Neue,sans-serif</FontFamily>
    <FontFamily x:Key="FontHeading">Montserrat,Segoe UI,Arial,sans-serif</FontFamily>

    <x:Double x:Key="FontSizeSmall">13</x:Double>
    <x:Double x:Key="FontSizeBody">16</x:Double>
    <x:Double x:Key="FontSizeMedium">20</x:Double>
    <x:Double x:Key="FontSizeLarge">36</x:Double>
    <x:Double x:Key="FontSizeXLarge">42</x:Double>
    
    <ControlTheme x:Key="NavListBoxItem"
                  TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Root"
                        Background="{DynamicResource PrimaryBrush}"
                        BorderBrush="Transparent"
                        BorderThickness="3,0,0,0"
                        Opacity="0.7"
                        Padding="28,12,20,12">
                    <ContentPresenter Background="Transparent"
                                      Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^:selected /template/ Border#Root">
            <Setter Property="Background" Value="#2E019DC6" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnDarkBrush}" />
        </Style>
        <Style Selector="^:selected:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="#2E019DC6" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^.nav-header">
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </ControlTemplate>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
