<Styles x:Class="Themes.Fjord.Fjord"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FluentTheme>
        <FluentTheme.Palettes>
            <ColorPaletteResources x:Key="Light"
                                   Accent="#177d72"
                                   AltHigh="#ffffff"
                                   BaseHigh="#202c33"
                                   BaseLow="#e4e9ec"
                                   BaseMedium="#73818a"
                                   ChromeLow="#f3f5f7"
                                   ChromeMedium="#e4e9ec" />
            <ColorPaletteResources x:Key="Dark"
                                   Accent="#298c7e"
                                   AltHigh="#1a2831"
                                   BaseHigh="#e4ecef"
                                   BaseLow="#2c3c46"
                                   BaseMedium="#a0b0b9"
                                   ChromeLow="#111b22"
                                   ChromeMedium="#2c3c46" />
        </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Fjord/Resources/Colors.axaml" />
                <ResourceInclude Source="avares://Fjord/Resources/Brushes.axaml" />
                <ResourceInclude Source="avares://Fjord/Resources/CornerRadius.axaml" />
                <ResourceInclude Source="avares://Fjord/Resources/Font.axaml" />
                <ResourceInclude Source="avares://Fjord/Resources/NavigationItem.axaml" />
                <ResourceInclude Source="avares://Fjord/Resources/Spacing.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <StyleInclude Source="avares://Fjord/Styles/Border.axaml" />
    <StyleInclude Source="avares://Fjord/Styles/Button.axaml" />
    <StyleInclude Source="avares://Fjord/Styles/Calendar.axaml" />
    <StyleInclude Source="avares://Fjord/Styles/CheckBox.axaml" />
    <StyleInclude Source="avares://Fjord/Styles/ComboBox.axaml" />
    <StyleInclude Source="avares://Fjord/Styles/DataGrid.axaml" />
    <StyleInclude Source="avares://Fjord/Styles/Expander.axaml" />
    <StyleInclude Source="avares://Fjord/Styles/Label.axaml" />
    <StyleInclude Source="avares://Fjord/Styles/ListBox.axaml" />
    <StyleInclude Source="avares://Fjord/Styles/Menu.axaml" />
    <StyleInclude Source="avares://Fjord/Styles/NumericUpDown.axaml" />
    <StyleInclude Source="avares://Fjord/Styles/PathIcon.axaml" />
    <StyleInclude Source="avares://Fjord/Styles/ProgressBar.axaml" />
    <StyleInclude Source="avares://Fjord/Styles/RadioButton.axaml" />
    <StyleInclude Source="avares://Fjord/Styles/ScrollBar.axaml" />
    <StyleInclude Source="avares://Fjord/Styles/Slider.axaml" />
    <StyleInclude Source="avares://Fjord/Styles/StackPanel.axaml" />
    <StyleInclude Source="avares://Fjord/Styles/SplitView.axaml" />
    <StyleInclude Source="avares://Fjord/Styles/TabControl.axaml" />
    <StyleInclude Source="avares://Fjord/Styles/TextBlock.axaml" />
    <StyleInclude Source="avares://Fjord/Styles/TextBox.axaml" />
    <StyleInclude Source="avares://Fjord/Styles/ToggleSwitch.axaml" />
    <StyleInclude Source="avares://Fjord/Styles/ToolTip.axaml" />
    <StyleInclude Source="avares://Fjord/Styles/Window.axaml" />

</Styles>
