<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <StreamGeometry x:Key="CheckCircleIcon">M12,1 A11,11 0 1 1 11.99,1 M6,12 L10,16 18,7</StreamGeometry>
        <StreamGeometry x:Key="RefreshIcon">M20,4 V10 H14 M20,10 A8,8 0 1 0 20,16</StreamGeometry>
        <StreamGeometry x:Key="InitializeDbIcon">M3,5 A9,4 0 1 0 21,5 A9,4 0 1 0 3,5 M3,5 V19 A9,4 0 0 0 21,19 V5</StreamGeometry>
        <StreamGeometry x:Key="NetworkWiredIcon">M8,1 H16 V7 H8 Z M11,7 H13 V13 H22 V22 H16 V15 H13 V22 H7 V15 H2 V22 H0 V13 H11 Z</StreamGeometry>
        <StreamGeometry x:Key="AddIcon">M10,2 H14 V10 H22 V14 H14 V22 H10 V14 H2 V10 H10 Z</StreamGeometry>
        <StreamGeometry x:Key="EditIcon">M3,17 L17,3 21,7 7,21 2,22 Z</StreamGeometry>
    </Styles.Resources>

    <Style Selector="PathIcon.icon-action">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource InputFocusBorderBrush}" />
    </Style>

    <Style Selector="PathIcon.icon-action:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource InputHoverBorderBrush}" />
    </Style>

    <Style Selector="PathIcon.icon-action:disabled">
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <Style Selector="PathIcon.icon-action.icon-danger">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <Style Selector="PathIcon.icon-action.icon-danger:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <Style Selector="PathIcon.icon-action.icon-danger:disabled">
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <Style Selector="PathIcon.status-error">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <Style Selector="PathIcon.status-success">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>

    <Style Selector="TextBox PathIcon.clear-icon">
        <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="TextBox:pointerover PathIcon.clear-icon">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="PathIcon.icon-action.clear-icon">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="PathIcon.db-status-up-to-date">
        <Setter Property="Data" Value="{DynamicResource CheckCircleIcon}" />
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>

    <Style Selector="PathIcon.db-status-update-available">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Data" Value="{DynamicResource RefreshIcon}" />
        <Setter Property="Foreground" Value="{DynamicResource TertiaryBrush}" />
    </Style>

    <Style Selector="PathIcon.db-status-not-initialized">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Data" Value="{DynamicResource InitializeDbIcon}" />
        <Setter Property="Foreground" Value="{DynamicResource TertiaryBrush}" />
    </Style>

    <Style Selector="PathIcon.shot-source-receiver">
        <Setter Property="Data" Value="{DynamicResource NetworkWiredIcon}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="PathIcon.shot-source-manual">
        <Setter Property="Data" Value="{DynamicResource AddIcon}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="PathIcon.shot-edited">
        <Setter Property="Data" Value="{DynamicResource EditIcon}" />
        <Setter Property="Foreground" Value="{DynamicResource TertiaryBrush}" />
    </Style>
</Styles>
