<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="ListBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMedium}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundTintBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ListBox.nav, ListBox.table-rows">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBox.nav">
        <Setter Property="Foreground" Value="{DynamicResource NavigationForegroundBrush}" />
        <Setter Property="ItemContainerTheme" Value="{DynamicResource NavigationItem}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem">
        <Setter Property="Theme" Value="{DynamicResource NavigationItem}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem /template/ ContentPresenter#PART_ContentPresenter, ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.nav ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter, ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource NavigationForegroundBrush}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource NavigationActiveTextBrush}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem.navigation-header TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarMutedBrush}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:not(.navigation-header) TextBlock">
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ListBox.table-rows ListBoxItem">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="20,14" />
    </Style>
</Styles>
