<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <x:Double x:Key="TextControlPlaceholderOpacity">1</x:Double>
    </Styles.Resources>
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource InputPlaceholderBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}" />
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="37" />
        <Setter Property="CaretBrush" Value="{DynamicResource LinkBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextWhiteBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox /template/ TextBlock#PART_Placeholder, TextBox /template/ TextBlock#PART_FloatingPlaceholder">
        <Setter Property="Foreground" Value="{DynamicResource InputPlaceholderBrush}" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement, TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
    </Style>
    <Style Selector="TextBox.error /template/ Border#PART_BorderElement, TextBox.error:focus /template/ Border#PART_BorderElement, TextBox:error /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="TextBox.success /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="TextBox:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>
</Styles>
