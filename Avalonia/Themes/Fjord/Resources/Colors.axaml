<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="PrimaryDarkColor">#177d72</Color>
            <Color x:Key="PrimaryDarkerColor">#11695f</Color>
            <Color x:Key="SecondaryColor">#177d72</Color>
            <Color x:Key="SecondaryDarkColor">#11695f</Color>
            <Color x:Key="TertiaryColor">#177d72</Color>
            <Color x:Key="TertiaryDarkColor">#11695f</Color>
            <Color x:Key="IconActionColor">#177d72</Color>
            <Color x:Key="IconActionHoverColor">#11695f</Color>
            <Color x:Key="AccentTextColor">#177d72</Color>
            <Color x:Key="AccentTextHoverColor">#11695f</Color>
            <Color x:Key="NearBlackColor">#202c33</Color>
            <Color x:Key="TextPrimaryColor">#202c33</Color>
            <Color x:Key="TextSecondaryColor">#73818a</Color>
            <Color x:Key="TextMutedColor">#73818a</Color>
            <Color x:Key="TextDisabledColor">#99a5aa</Color>
            <Color x:Key="TableHeaderTextColor">#849097</Color>
            <Color x:Key="BackgroundWhiteColor">#ffffff</Color>
            <Color x:Key="BackgroundLightColor">#f3f5f7</Color>
            <Color x:Key="BackgroundSubtleColor">#f8fafb</Color>
            <Color x:Key="BackgroundTintedColor">#e6f3f0</Color>
            <Color x:Key="BackgroundMutedColor">#f5f8f8</Color>
            <Color x:Key="BorderLightColor">#e4e9ec</Color>
            <Color x:Key="BorderMediumColor">#dce3e6</Color>
            <Color x:Key="BorderDarkColor">#177d72</Color>
            <Color x:Key="BorderTableColor">#edf0f2</Color>
            <Color x:Key="InputHoverBorderColor">#76b9ae</Color>
            <Color x:Key="SidebarColor">#17252d</Color>
            <Color x:Key="NavigationActiveColor">#22343e</Color>
            <Color x:Key="SuccessColor">#38a783</Color>
            <Color x:Key="WarningColor">#d29a3d</Color>
            <Color x:Key="ErrorColor">#c33f45</Color>
            <Color x:Key="ErrorHoverColor">#a93137</Color>
            <Color x:Key="BadgeSuccessBackgroundColor">#eaf5ef</Color>
            <Color x:Key="BadgeSuccessForegroundColor">#317b62</Color>
            <Color x:Key="BadgeWarningBackgroundColor">#fbf3e5</Color>
            <Color x:Key="BadgeWarningForegroundColor">#9a6b22</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="PrimaryDarkColor">#298c7e</Color>
            <Color x:Key="PrimaryDarkerColor">#237b6f</Color>
            <Color x:Key="SecondaryColor">#298c7e</Color>
            <Color x:Key="SecondaryDarkColor">#237b6f</Color>
            <Color x:Key="TertiaryColor">#298c7e</Color>
            <Color x:Key="TertiaryDarkColor">#237b6f</Color>
            <Color x:Key="IconActionColor">#298c7e</Color>
            <Color x:Key="IconActionHoverColor">#237b6f</Color>
            <Color x:Key="AccentTextColor">#7ad4be</Color>
            <Color x:Key="AccentTextHoverColor">#a2e3d3</Color>
            <Color x:Key="NearBlackColor">#e4ecef</Color>
            <Color x:Key="TextPrimaryColor">#e4ecef</Color>
            <Color x:Key="TextSecondaryColor">#a0b0b9</Color>
            <Color x:Key="TextMutedColor">#a0b0b9</Color>
            <Color x:Key="TextDisabledColor">#657a87</Color>
            <Color x:Key="TableHeaderTextColor">#a0b0b9</Color>
            <Color x:Key="BackgroundWhiteColor">#1a2831</Color>
            <Color x:Key="BackgroundLightColor">#111b22</Color>
            <Color x:Key="BackgroundSubtleColor">#17242c</Color>
            <Color x:Key="BackgroundTintedColor">#203d3b</Color>
            <Color x:Key="BackgroundMutedColor">#20323c</Color>
            <Color x:Key="BorderLightColor">#2c3c46</Color>
            <Color x:Key="BorderMediumColor">#3b505c</Color>
            <Color x:Key="BorderDarkColor">#298c7e</Color>
            <Color x:Key="BorderTableColor">#2c3c46</Color>
            <Color x:Key="InputHoverBorderColor">#65bdae</Color>
            <Color x:Key="SidebarColor">#0e181f</Color>
            <Color x:Key="NavigationActiveColor">#20343e</Color>
            <Color x:Key="SuccessColor">#75d1ad</Color>
            <Color x:Key="WarningColor">#e8c278</Color>
            <Color x:Key="ErrorColor">#ef8990</Color>
            <Color x:Key="ErrorHoverColor">#ce656d</Color>
            <Color x:Key="BadgeSuccessBackgroundColor">#203d34</Color>
            <Color x:Key="BadgeSuccessForegroundColor">#8bd5b3</Color>
            <Color x:Key="BadgeWarningBackgroundColor">#3d3425</Color>
            <Color x:Key="BadgeWarningForegroundColor">#e8c278</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Color x:Key="TextOnDarkColor">#e8eef0</Color>
    <Color x:Key="TextWhiteColor">#ffffff</Color>
    <Color x:Key="SidebarTextColor">#c1cdd1</Color>
    <Color x:Key="SidebarMutedColor">#94a5ad</Color>
    <Color x:Key="SidebarHoverColor">#0fffffff</Color>
    <Color x:Key="NavigationIndicatorColor">#57c2ad</Color>
    <Color x:Key="OverlayColor">#99000000</Color>
</ResourceDictionary>
