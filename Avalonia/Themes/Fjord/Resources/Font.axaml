<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="FontBody">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
    <FontFamily x:Key="FontHeading">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
    <FontFamily x:Key="FontMono">Consolas,Courier New,monospace</FontFamily>

    <x:Double x:Key="FontSizeSmall">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeMedium">15</x:Double>
    <x:Double x:Key="FontSizeMediumLarge">18</x:Double>
    <x:Double x:Key="FontSizeLarge">23</x:Double>
    <x:Double x:Key="FontSizeXLarge">30</x:Double>

</ResourceDictionary>
