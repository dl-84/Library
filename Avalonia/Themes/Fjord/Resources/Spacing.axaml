<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:Double x:Key="SpacingXSmall">4</x:Double>
    <x:Double x:Key="SpacingSmall">8</x:Double>
    <x:Double x:Key="SpacingRegular">12</x:Double>
    <x:Double x:Key="SpacingMedium">16</x:Double>
    <x:Double x:Key="SpacingLarge">24</x:Double>
    <x:Double x:Key="SpacingXLarge">32</x:Double>
    <x:Double x:Key="SidebarWidth">220</x:Double>

    <Thickness x:Key="PaddingCard">20,18</Thickness>
    <Thickness x:Key="PaddingSidebar">14,22,14,14</Thickness>
    <Thickness x:Key="MarginTopMedium">0,16,0,0</Thickness>

</ResourceDictionary>
