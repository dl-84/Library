<Window x:Class="Controls.ConfirmDialog.ConfirmDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:local="using:Controls.ConfirmDialog"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:DataType="local:ConfirmDialog"
        Background="Transparent"
        CanResize="False"
        MinHeight="180"
        SizeToContent="Height"
        TransparencyLevelHint="Transparent"
        Width="460"
        WindowDecorations="None"
        WindowStartupLocation="CenterOwner">

    <!--  Disable Hover Styles  -->
    <Window.Styles>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
            <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
            <Setter Property="TextElement.Foreground" Value="{Binding $parent[Button].Foreground}" />
        </Style>
    </Window.Styles>

    <Border ClipToBounds="True"
            CornerRadius="10">
        <Grid Background="{DynamicResource AppBackgroundAltBrush}"
              RowDefinitions="Auto,*,Auto">

            <Border Grid.Row="0"
                    Background="{DynamicResource SecondaryBrush}"
                    Padding="24,12">
                <TextBlock FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Text="{Binding DialogTitle}" />
            </Border>

            <TextBlock Grid.Row="1"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="24,20,24,16"
                       Text="{Binding Message}"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,24"
                        Orientation="Horizontal"
                        Spacing="8">
                <Button Background="{DynamicResource ErrorBrush}"
                        Click="OnAcceptClicked"
                        Content="{Binding AcceptText}"
                        Foreground="{DynamicResource PrimaryForegroundBrush}" />
                <Button x:Name="CancelButton"
                        Background="{DynamicResource SecondaryBrush}"
                        Click="OnCancelClicked"
                        Content="{Binding CancelText}"
                        Foreground="{DynamicResource PrimaryForegroundBrush}" />
            </StackPanel>

        </Grid>
    </Border>
</Window>
