<Window x:Class="Controls.InfoDialog.InfoDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:converters="using:Avalonia.Data.Converters"
        xmlns:local="using:Controls.InfoDialog"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:DataType="local:InfoDialog"
        Background="Transparent"
        CanResize="False"
        MinWidth="400"
        SizeToContent="Height"
        TransparencyLevelHint="Transparent"
        Width="480"
        WindowDecorations="None"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://InfoDialog/Resources/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border ClipToBounds="True"
            CornerRadius="10">
        <Grid Background="{DynamicResource AppBackgroundAltBrush}"
              RowDefinitions="Auto,*">

            <Border Grid.Row="0"
                    Background="{DynamicResource AppBackgroundAltBrush}"
                    BorderBrush="{DynamicResource BorderMediumBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,12">
                <Grid ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="{DynamicResource SpacingMedium}">
                    <TextBlock Grid.Column="0"
                               Classes="h4"
                               Text="{Binding DialogTitle}"
                               VerticalAlignment="Center" />
                    <PathIcon Grid.Column="1"
                              Classes="icon-action"
                              Data="{DynamicResource CopyIcon}"
                              Height="14"
                              PointerPressed="OnCopyClicked"
                              Width="14"
                              IsVisible="{Binding Message, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
                    <PathIcon Grid.Column="2"
                              Classes="icon-action"
                              Data="{DynamicResource CloseIcon}"
                              Height="14"
                              PointerPressed="OnCloseClicked"
                              Width="14" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1"
                        Margin="24,20,24,20"
                        Orientation="Horizontal"
                        Spacing="16">
                <PathIcon x:Name="IconImage"
                          Height="48"
                          VerticalAlignment="Center"
                          Width="48" />
                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                           MaxWidth="360"
                           Text="{Binding Message}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </StackPanel>

        </Grid>
    </Border>
</Window>
