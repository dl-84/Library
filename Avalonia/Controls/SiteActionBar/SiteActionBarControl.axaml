<UserControl x:Class="Controls.SiteActionBar.SiteActionBarControl"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:local="using:Controls.SiteActionBar"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:DataType="local:SiteActionBarControl">

    <Grid ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0"
                 HorizontalAlignment="Left"
                 PlaceholderText="{Binding #Root.SearchPlaceholder}"
                 Text="{Binding #Root.SearchText, Mode=TwoWay}"
                 Width="300">
            <TextBox.InnerRightContent>
                <PathIcon Classes="icon-action icon-danger"
                          Data="{DynamicResource CloseIcon}"
                          Height="12"
                          Margin="0,0,10,0"
                          PointerPressed="OnClearSearchIconPressed"
                          Width="12"
                          IsVisible="{Binding #Root.SearchText, Converter={x:Static local:SiteActionBarControl.IsNotEmptyConverter}}" />
            </TextBox.InnerRightContent>
        </TextBox>

        <StackPanel Grid.Column="1"
                    Margin="0,0,10,0"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource SpacingMedium}"
                    VerticalAlignment="Center">
            <PathIcon Classes="icon-action"
                      Data="{DynamicResource RefreshIcon}"
                      PointerPressed="OnRefreshIconPressed"
                      ToolTip.HorizontalOffset="0"
                      ToolTip.Placement="TopEdgeAlignedRight"
                      ToolTip.Tip="{Binding #Root.RefreshTooltip}"
                      ToolTip.VerticalOffset="-2"
                      VerticalAlignment="Center"
                      IsVisible="{Binding #Root.IsRefreshVisible}" />
            <PathIcon Classes="icon-action"
                      Data="{DynamicResource AddIcon}"
                      PointerPressed="OnAddIconPressed"
                      ToolTip.HorizontalOffset="0"
                      ToolTip.Placement="TopEdgeAlignedRight"
                      ToolTip.Tip="{Binding #Root.AddTooltip}"
                      ToolTip.VerticalOffset="-2"
                      VerticalAlignment="Center" />
            <PathIcon Classes="icon-action"
                      Data="{DynamicResource EditIcon}"
                      PointerPressed="OnEditIconPressed"
                      ToolTip.HorizontalOffset="0"
                      ToolTip.Placement="TopEdgeAlignedRight"
                      ToolTip.Tip="{Binding #Root.EditTooltip}"
                      ToolTip.VerticalOffset="-2"
                      VerticalAlignment="Center">
                <PathIcon.IsEnabled>
                    <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                        <Binding Path="#Root.IsActionEnabled" />
                        <Binding Path="#Root.IsEditEnabled" />
                    </MultiBinding>
                </PathIcon.IsEnabled>
            </PathIcon>
            <PathIcon Classes="icon-action icon-danger"
                      Data="{DynamicResource DeleteIcon}"
                      PointerPressed="OnDeleteIconPressed"
                      ToolTip.HorizontalOffset="0"
                      ToolTip.Placement="TopEdgeAlignedRight"
                      ToolTip.Tip="{Binding #Root.DeleteTooltip}"
                      ToolTip.VerticalOffset="-2"
                      VerticalAlignment="Center"
                      IsEnabled="{Binding #Root.IsActionEnabled}" />
        </StackPanel>
    </Grid>
</UserControl>
