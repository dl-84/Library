<UserControl x:Class="Controls.CounterCard.CounterCardControl"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:local="using:Controls.CounterCard"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:DataType="local:CounterCardControl">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CounterCard/Resources/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.danger">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*">
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="{DynamicResource SpacingSmall}">
                <PathIcon Classes="icon-action"
                          Data="{DynamicResource InfoIcon}"
                          Foreground="{DynamicResource TertiaryBrush}"
                          Height="18"
                          ToolTip.Tip="{Binding #Root.InfoText}"
                          VerticalAlignment="Center"
                          Width="18" />
                <TextBlock Classes="label"
                           Classes.danger="{Binding #Root.IsDanger}"
                           FontWeight="Normal"
                           Text="{Binding #Root.Label}"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Classes="h2"
                       FontSize="{DynamicResource FontSizeMedium}"
                       FontWeight="Normal"
                       HorizontalAlignment="Right"
                       LineHeight="22"
                       Text="{Binding #Root.Value}"
                       VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
