<UserControl x:Class="Controls.LicenseTable.LicenseTableControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:local="using:Controls.LicenseTable"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Classes="card"
            Padding="0">
        <StackPanel>
            <Border Background="{DynamicResource AccentGreenBrush}"
                    Padding="24,10">
                <Grid ColumnDefinitions="*,80,120,48">
                    <TextBlock x:Name="NameHeaderText"
                               Classes="label"
                               FontSize="16"
                               Foreground="{DynamicResource AccentForegroundBrush}" />
                    <TextBlock x:Name="VersionHeaderText"
                               Grid.Column="1"
                               Classes="label"
                               FontSize="16"
                               Foreground="{DynamicResource AccentForegroundBrush}"
                               TextAlignment="Center" />
                    <TextBlock x:Name="LicenseHeaderText"
                               Grid.Column="2"
                               Classes="label"
                               FontSize="16"
                               Foreground="{DynamicResource AccentForegroundBrush}"
                               TextAlignment="Center" />
                    <TextBlock x:Name="LinkHeaderText"
                               Grid.Column="3"
                               Classes="label"
                               FontSize="16"
                               Foreground="{DynamicResource AccentForegroundBrush}"
                               TextAlignment="Center" />
                </Grid>
            </Border>
            <ItemsControl x:Name="RowsControl"
                          Margin="24,0,24,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:PackageModel">
                        <Grid ColumnDefinitions="*,80,120,48"
                              MinHeight="36">
                            <StackPanel Margin="0,6,0,6"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Classes="muted"
                                           Text="{Binding Copyright}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding Copyright, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Version}"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Cursor="Hand"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       PointerPressed="OnPointerLinkClicked"
                                       Tag="{Binding LicenseUrl}"
                                       Text="{Binding LicenseType}"
                                       TextDecorations="Underline"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding LicenseUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <Image Grid.Column="3"
                                   Cursor="Hand"
                                   Height="16"
                                   HorizontalAlignment="Center"
                                   PointerPressed="OnPointerLinkClicked"
                                   Source="avares://LicenseTable/Assets/ExternalLink.png"
                                   Tag="{Binding PackageUrl}"
                                   VerticalAlignment="Center"
                                   Width="16"
                                   IsVisible="{Binding PackageUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>

</UserControl>
