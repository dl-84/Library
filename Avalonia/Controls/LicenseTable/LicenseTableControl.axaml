<UserControl x:Class="Controls.LicenseTable.LicenseTableControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:local="using:Controls.LicenseTable"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Classes="card"
            Padding="0">
        <StackPanel>
            <Border x:Name="HeaderBorder"
                    Padding="24,10">
                <Grid ColumnDefinitions="*,80,120,48">
                    <TextBlock x:Name="NameHeaderText"
                               Classes="label table-column-header" />
                    <TextBlock x:Name="VersionHeaderText"
                               Grid.Column="1"
                               Classes="label table-column-header"
                               TextAlignment="Center" />
                    <TextBlock x:Name="LicenseHeaderText"
                               Grid.Column="2"
                               Classes="label table-column-header"
                               TextAlignment="Center" />
                    <TextBlock x:Name="LinkHeaderText"
                               Grid.Column="3"
                               Classes="label table-column-header"
                               TextAlignment="Center" />
                </Grid>
            </Border>
            <ItemsControl x:Name="RowsControl"
                          Margin="24,0,24,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:PackageModel">
                        <Grid ColumnDefinitions="*,80,120,48"
                              MinHeight="36">
                            <StackPanel Margin="0,6,0,6"
                                        VerticalAlignment="Center">
                                <TextBlock Foreground="{Binding PrimaryTextColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:LicenseTableControl}}"
                                           Text="{Binding Name}" />
                                <TextBlock Classes="muted"
                                           Foreground="{Binding SecondaryTextColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:LicenseTableControl}}"
                                           Text="{Binding Copyright}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Foreground="{Binding PrimaryTextColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:LicenseTableControl}}"
                                       Text="{Binding Version}"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Classes="table-link"
                                       HorizontalAlignment="Center"
                                       PointerPressed="OnPointerLinkClicked"
                                       Tag="{Binding LicenseUrl}"
                                       Text="{Binding LicenseType}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding HasLicenseLink}" />
                            <Image Grid.Column="3"
                                   Cursor="Hand"
                                   Height="16"
                                   HorizontalAlignment="Center"
                                   PointerPressed="OnPointerLinkClicked"
                                   Source="avares://LicenseTable/Assets/ExternalLink.png"
                                   Tag="{Binding PackageUrl}"
                                   VerticalAlignment="Center"
                                   Width="16"
                                   IsVisible="{Binding HasPackageUrl}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
