<UserControl x:Class="Controls.LicenseTable.LicenseTableControl"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:local="using:Controls.LicenseTable.Models"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://LicenseTable/Resources/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Classes="card"
            ClipToBounds="True"
            Padding="0">
        <Grid RowDefinitions="Auto,*">
            <Border x:Name="HeaderBorder"
                    BorderBrush="{DynamicResource BorderTableBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="24,10">
                <Grid ColumnDefinitions="*,80,120,48"
                      Height="32">
                    <TextBlock x:Name="NameHeaderText"
                               Classes="table-header"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="VersionHeaderText"
                               Grid.Column="1"
                               Classes="table-header"
                               TextAlignment="Center"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="LicenseHeaderText"
                               Grid.Column="2"
                               Classes="table-header"
                               TextAlignment="Center"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="LinkHeaderText"
                               Grid.Column="3"
                               Classes="table-header"
                               TextAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1">
                <ItemsControl x:Name="RowsControl"
                              Margin="24,0,24,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:PackageModel">
                            <Grid ColumnDefinitions="*,80,120,48"
                                  MinHeight="36">
                                <StackPanel Margin="0,6,0,6"
                                            VerticalAlignment="Center">
                                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding Name}" />
                                    <TextBlock Classes="muted"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="{Binding Copyright}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding Version}"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Classes="table-link"
                                           HorizontalAlignment="Center"
                                           PointerPressed="OnPointerLinkClicked"
                                           Tag="{Binding LicenseUrl}"
                                           Text="{Binding LicenseType}"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding HasLicenseLink}" />
                                <Border Grid.Column="3"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        HorizontalAlignment="Center"
                                        Padding="6"
                                        PointerPressed="OnPointerLinkClicked"
                                        Tag="{Binding PackageUrl}"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding HasPackageUrl}">
                                    <Path Data="{DynamicResource ExternalLinkOutlineIcon}"
                                          Fill="Transparent"
                                          Height="16"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource TertiaryBrush}"
                                          StrokeJoin="Round"
                                          StrokeLineCap="Round"
                                          StrokeThickness="1.5"
                                          Width="16" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
