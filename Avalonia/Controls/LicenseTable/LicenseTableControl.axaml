<UserControl x:Class="Controls.LicenseTable.LicenseTableControl"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:local="using:Controls.LicenseTable.Models"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://LicenseTable/Resources/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Classes="card"
            Padding="0">
        <StackPanel>
            <Border x:Name="HeaderBorder"
                    BorderBrush="{DynamicResource BorderTableBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="24,10">
                <Grid ColumnDefinitions="*,80,120,48"
                      Height="32">
                    <TextBlock x:Name="NameHeaderText"
                               Classes="table-header"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="VersionHeaderText"
                               Grid.Column="1"
                               Classes="table-header"
                               TextAlignment="Center"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="LicenseHeaderText"
                               Grid.Column="2"
                               Classes="table-header"
                               TextAlignment="Center"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="LinkHeaderText"
                               Grid.Column="3"
                               Classes="table-header"
                               TextAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ItemsControl x:Name="RowsControl"
                          Margin="24,0,24,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:PackageModel">
                        <Grid ColumnDefinitions="*,80,120,48"
                              MinHeight="36">
                            <StackPanel Margin="0,6,0,6"
                                        VerticalAlignment="Center">
                                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding Name}" />
                                <TextBlock Classes="muted"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="{Binding Copyright}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding Version}"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Classes="table-link"
                                       HorizontalAlignment="Center"
                                       PointerPressed="OnPointerLinkClicked"
                                       Tag="{Binding LicenseUrl}"
                                       Text="{Binding LicenseType}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding HasLicenseLink}" />
                            <PathIcon Grid.Column="3"
                                      Cursor="Hand"
                                      Data="{DynamicResource ExternalLinkIcon}"
                                      Foreground="{DynamicResource TertiaryBrush}"
                                      Height="16"
                                      HorizontalAlignment="Center"
                                      PointerPressed="OnPointerLinkClicked"
                                      Tag="{Binding PackageUrl}"
                                      VerticalAlignment="Center"
                                      Width="16"
                                      IsVisible="{Binding HasPackageUrl}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
