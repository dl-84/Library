<UserControl x:Class="Controls.FormField.FormFieldControl"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:local="using:Controls.FormField"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:DataType="local:FormFieldControl">

    <StackPanel Spacing="4">
        <TextBlock Classes="label"
                   Text="{Binding #Root.Label}" />
        <TextBox x:Name="InputTextBox"
                 Classes.error="{Binding #Root.IsError}"
                 MaxLength="{Binding #Root.MaxLength}"
                 Text="{Binding #Root.Text, Mode=TwoWay}"
                 IsEnabled="{Binding #Root.IsInputEnabled}">
            <TextBox.InnerRightContent>
                <PathIcon Classes="icon-action clear-icon"
                          Data="{DynamicResource CloseIcon}"
                          Height="12"
                          Margin="0,0,10,0"
                          PointerPressed="OnClearIconPressed"
                          Width="12" />
            </TextBox.InnerRightContent>
        </TextBox>
        <TextBlock Classes="hint-error"
                   Text="{Binding #Root.ErrorMessage}"
                   IsVisible="{Binding #Root.IsError}" />
    </StackPanel>
</UserControl>
