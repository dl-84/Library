<UserControl x:Class="Controls.TitleBar.TitleBarControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:local="using:Controls.TitleBar"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:CompileBindings="False">

    <UserControl.Resources>

        <ControlTheme x:Key="WindowControlButton"
                      TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

    </UserControl.Resources>

    <Grid ColumnDefinitions="220,*"
          Height="36">

        <!--  Mac Buttons  -->
        <Border Grid.Column="0"
                Background="{Binding PrimaryColor, RelativeSource={RelativeSource AncestorType=local:TitleBarControl}}">
            <StackPanel x:Name="MacOsButtons"
                        Margin="14,0,0,0"
                        Orientation="Horizontal"
                        PointerEntered="OnMacButtonsPointerEntered"
                        PointerExited="OnMacButtonsPointerExited"
                        Spacing="10"
                        VerticalAlignment="Center">
                <Border Background="#FF5C5F"
                        CornerRadius="6"
                        Cursor="Hand"
                        Height="12"
                        PointerPressed="OnMacCloseClicked"
                        Width="12">
                    <Path x:Name="MacCloseIcon"
                          Data="M0,0 L5,5 M5,0 L0,5"
                          Height="5"
                          HorizontalAlignment="Center"
                          IsHitTestVisible="False"
                          Opacity="0"
                          Stretch="None"
                          Stroke="#9B1B0F"
                          StrokeLineCap="Round"
                          StrokeThickness="1.75"
                          VerticalAlignment="Center"
                          Width="5" />
                </Border>
                <Border Background="#FFC800"
                        CornerRadius="6"
                        Cursor="Hand"
                        Height="12"
                        PointerPressed="OnMacMinimizeClicked"
                        Width="12">
                    <Path x:Name="MacMinimizeIcon"
                          Data="M0,1 L6,1"
                          Height="2"
                          HorizontalAlignment="Center"
                          IsHitTestVisible="False"
                          Opacity="0"
                          Stretch="None"
                          Stroke="#9B6200"
                          StrokeLineCap="Round"
                          StrokeThickness="1.75"
                          VerticalAlignment="Center"
                          Width="6" />
                </Border>
                <Border x:Name="MacMaximizeBorder"
                        Background="#35C759"
                        CornerRadius="6"
                        Cursor="Hand"
                        Height="12"
                        PointerPressed="OnMacMaximizeClicked"
                        Width="12">
                    <Path x:Name="MacMaximizeIcon"
                          Data="M1,6 L6,1 M4,1 L6,1 L6,3 M1,4 L1,6 L3,6"
                          Height="7"
                          HorizontalAlignment="Center"
                          IsHitTestVisible="False"
                          Opacity="0"
                          Stretch="None"
                          Stroke="#0B6B1F"
                          StrokeLineCap="Round"
                          StrokeThickness="1.75"
                          VerticalAlignment="Center"
                          Width="7" />
                </Border>
            </StackPanel>
        </Border>

        <!--  Drag Area + Windows Buttons  -->
        <Border Grid.Column="1"
                Background="{Binding BackgroundColor, RelativeSource={RelativeSource AncestorType=local:TitleBarControl}}">
            <Grid ColumnDefinitions="*,Auto">
                <Panel Grid.Column="0"
                       Background="Transparent"
                       Cursor="Hand"
                       PointerPressed="OnTitleBarDrag" />
                <StackPanel x:Name="WindowControlButtons"
                            Grid.Column="1"
                            Orientation="Horizontal">
                    <Button x:Name="MinimizeButton"
                            Click="OnMinimizeClicked"
                            MinWidth="0"
                            PointerEntered="OnMinimizeButtonPointerEntered"
                            PointerExited="OnMinimizeButtonPointerExited"
                            Theme="{StaticResource WindowControlButton}"
                            Width="50">
                        <TextBlock x:Name="MinimizeIcon"
                                   Text="─" />
                    </Button>
                    <Button x:Name="MaximizeButton"
                            Click="OnMaximizeRestoreClicked"
                            MinWidth="0"
                            PointerEntered="OnMaximizeButtonPointerEntered"
                            PointerExited="OnMaximizeButtonPointerExited"
                            Theme="{StaticResource WindowControlButton}"
                            Width="50">
                        <Path x:Name="MaximizeIcon"
                              Data="M0,0 H11 V11 H0 Z"
                              HorizontalAlignment="Center"
                              StrokeThickness="1.5"
                              VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="CloseButton"
                            Click="OnCloseClicked"
                            MinWidth="0"
                            PointerEntered="OnCloseButtonPointerEntered"
                            PointerExited="OnCloseButtonPointerExited"
                            Theme="{StaticResource WindowControlButton}"
                            Width="50">
                        <TextBlock x:Name="CloseIcon"
                                   Text="✕" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
