<UserControl x:Class="Controls.TitleBar.TitleBarControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:icons="using:Controls.TitleBar.Buttons"
             xmlns:local="using:Controls.TitleBar"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:CompileBindings="False">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://TitleBar/Assets/Resources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid ColumnDefinitions="220,*"
          Height="36">

        <!--  Mac Buttons  -->
        <Border Grid.Column="0"
                Background="{Binding PrimaryColor, RelativeSource={RelativeSource AncestorType=local:TitleBarControl}}">
            <StackPanel x:Name="MacTrafficLights"
                        Margin="14,0,0,0"
                        Orientation="Horizontal"
                        PointerEntered="OnMacButtonsPointerEntered"
                        PointerExited="OnMacButtonsPointerExited"
                        Spacing="10"
                        VerticalAlignment="Center">
                <icons:MacButton x:Name="MacCloseIcon"
                                 PointerPressed="OnMacButtonPressed"
                                 Type="MacClose" />
                <icons:MacButton x:Name="MacMinimizeIcon"
                                 PointerPressed="OnMacButtonPressed"
                                 Type="MacMinimize" />
                <icons:MacButton x:Name="MacMaximizeIcon"
                                 PointerPressed="OnMacButtonPressed"
                                 Type="MacMaximize" />
            </StackPanel>
        </Border>

        <!--  Drag Area + Windows Buttons  -->
        <Border Grid.Column="1"
                Background="{Binding BackgroundColor, RelativeSource={RelativeSource AncestorType=local:TitleBarControl}}">
            <Grid ColumnDefinitions="*,Auto">
                <Panel Grid.Column="0"
                       Background="Transparent"
                       Cursor="Hand"
                       PointerPressed="OnTitleBarDrag" />
                <StackPanel x:Name="WindowControlButtons"
                            Grid.Column="1"
                            Orientation="Horizontal">
                    <icons:WinButton PointerPressed="OnWinButtonPressed"
                                     Type="WinMinimize" />
                    <icons:WinButton PointerPressed="OnWinButtonPressed"
                                     Type="WinMaximize" />
                    <icons:WinButton PointerPressed="OnWinButtonPressed"
                                     Type="WinClose" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
