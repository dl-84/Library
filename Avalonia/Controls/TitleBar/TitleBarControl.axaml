<UserControl x:Class="Controls.TitleBar.TitleBarControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:icons="using:Controls.TitleBar.Buttons"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="ContentBorder"
            Background="{DynamicResource AppBackgroundAltBrush}"
            Height="36">
        <Grid ColumnDefinitions="*,Auto">
            <Panel Grid.Column="0"
                   Background="Transparent"
                   Cursor="Hand"
                   PointerPressed="OnTitleBarDrag" />
            <StackPanel x:Name="WindowControlButtons"
                        Grid.Column="1"
                        Orientation="Horizontal">
                <icons:WinButton PointerPressed="OnWinButtonPressed"
                                 Type="WinMinimize" />
                <icons:WinButton PointerPressed="OnWinButtonPressed"
                                 Type="WinMaximize" />
                <icons:WinButton PointerPressed="OnWinButtonPressed"
                                 Type="WinClose" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
